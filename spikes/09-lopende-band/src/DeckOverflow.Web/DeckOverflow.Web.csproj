<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <RootNamespace>DeckOverflow.Web</RootNamespace>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- Kleinere download: geen cultuurdata nodig voor de spike -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Het bord wordt via reflectie naar JSON bewaard: voor een spike niet trimmen, liever een grotere download -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeckOverflow.Engine\DeckOverflow.Engine.csproj" />
    <!-- Events en snapshots gaan via reflectie naar JSON: niets uit de motor wegtrimmen -->
    <TrimmerRootAssembly Include="DeckOverflow.Engine" />
  </ItemGroup>

</Project>
