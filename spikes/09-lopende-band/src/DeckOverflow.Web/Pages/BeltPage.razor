@page "/"

@* De Lopende Band (H6): leg band en machines op een rooster, en kijk hoe de kisten rijden. Een band die terugkomt,
   is een lus. Links de gereedschapsbak, in het midden het rooster, rechts de opdracht en de testgevallen. *@

@if (!S.Loaded)
{
    <div class="overlay"><h1>Deck Overflow</h1><p>laden...</p></div>
    return;
}

<div class="room">
    <header>
        <div class="titles">
            <h1>@S.T("ui.title")</h1>
            <p>@S.T("ui.subtitle")</p>
        </div>
        <nav class="steps">
            @for (int i = 0; i < LevelCatalog.All.Count; i++)
            {
                int index = i;
                var l = LevelCatalog.All[i];
                bool open = Open(index);
                <button class="step @(index == _levelIndex ? "current" : "") @(_beaten.Contains(l.Key) ? "beaten" : "") @(l.Bug ? "bug" : "")"
                        disabled="@(!open || _playing)" @onclick="() => SelectLevel(index)" title="@(open ? S.T($"level.{l.Key}.name") : "?")">
                    <span class="circle">@(index + 1)</span>
                    <span class="label">@(open ? S.T($"level.{l.Key}.name") : "?")</span>
                </button>
            }
        </nav>
    </header>

    <main class="floor">
        <section class="toolbox">
            <h2>@S.T("ui.toolbox")</h2>
            <div class="tools">
                <button class="tool @(_tool == BeltTool ? "held" : "")" disabled="@(!Editing)" @onclick="() => _tool = BeltTool">
                    <span class="glyph">→</span> @S.T("ui.belt")
                </button>
                @foreach (var offer in Level.Palette)
                {
                    var o = offer;
                    int left = o.Max - Used(o);
                    <button class="tool @(o.Kind.ToString().ToLowerInvariant()) @(_tool == o.Id ? "held" : "")" disabled="@(!Editing || left <= 0)" @onclick="() => _tool = o.Id">
                        <span class="glyph">@Components.PieceText.Offer(o)</span> @S.T($"ui.offer.{o.Kind}") <small>×@left</small>
                    </button>
                }
                <button class="tool erase @(_tool == EraseTool ? "held" : "")" disabled="@(!Editing)" @onclick="() => _tool = EraseTool">✕ @S.T("ui.erase")</button>
            </div>
            <p class="hint">@S.T("ui.toolbox-hint")</p>

            @if (Editing && _selected is { } cell && _board.TryGetValue(cell, out var piece))
            {
                @* Het paneel van het gekozen stuk: richtingen, getal, voorwaarde *@
                <div class="inspector">
                    <h3>@S.T($"ui.piece.{piece.GetType().Name}")</h3>
                    @switch (piece)
                    {
                        case Belt belt:
                            @DirPicker(S.T("ui.out"), belt.Out, TurnBeltAsync)
                            break;
                        case Machine m:
                            @ValuePicker(m.Op.Operand, v => ChangeAsync(p => p is Machine x ? x with { Op = x.Op with { Operand = v } } : p))
                            @DirPicker(S.T("ui.out"), m.Out, d => ChangeAsync(p => p is Machine x ? x with { Out = d } : p))
                            break;
                        case Gate g:
                            @if (OfferFor(g) is { Conditions: { Count: > 1 } kinds })
                            {
                                <label class="row">@S.T("ui.condition")
                                    <select value="@g.When.Kind" @onchange="e => ChangeAsync(p => p is Gate x ? x with { When = x.When with { Kind = Enum.Parse<CondKind>((string)e.Value!) } } : p)">
                                        @foreach (var k in kinds)
                                        {
                                            <option value="@k">@Components.PieceText.Condition(new Condition(k, g.When.N))</option>
                                        }
                                    </select>
                                </label>
                            }
                            @ValuePicker(g.When.N, v => ChangeAsync(p => p is Gate x ? x with { When = x.When with { N = v } } : p))
                            @DirPicker("✓ " + S.T("ui.if-true"), g.IfTrue, d => ChangeAsync(p => p is Gate x ? x with { IfTrue = d } : p))
                            @DirPicker("✗ " + S.T("ui.if-false"), g.IfFalse, d => ChangeAsync(p => p is Gate x ? x with { IfFalse = d } : p))
                            break;
                        case Counter c:
                            @ValuePicker(c.Times, v => ChangeAsync(p => p is Counter x ? x with { Times = v } : p))
                            @DirPicker("↻ " + S.T("ui.loop"), c.Loop, d => ChangeAsync(p => p is Counter x ? x with { Loop = d } : p))
                            @DirPicker("⇥ " + S.T("ui.done"), c.Done, d => ChangeAsync(p => p is Counter x ? x with { Done = d } : p))
                            break;
                    }
                    <button class="secondary" @onclick="RemoveSelectedAsync">✕ @S.T("ui.remove")</button>
                </div>
            }
            <button class="secondary clear" disabled="@(!Editing)" @onclick="ClearAsync">↺ @S.T("ui.clear")</button>
        </section>

        <section class="arena">
            @* Het rooster, het product en het front in de verte: de PixiJS-stage *@
            <div class="stage-box" @ref="_host"></div>

            <div class="controls">
                @if (Editing)
                {
                    <button class="primary" @onclick="RunAsync">▶ @S.T("ui.run")</button>
                }
                else
                {
                    @if (_playing)
                    {
                        <button @onclick="Stop">⏸ @S.T("ui.pause")</button>
                    }
                    else if (!AllDone)
                    {
                        <button class="primary" @onclick="PlayAsync">▶ @S.T("ui.resume")</button>
                        <button @onclick="StepOnce">⏭ @S.T("ui.step")</button>
                    }
                    @if (!_playing)
                    {
                        <button @onclick="ReplayAsync">↻ @S.T("ui.replay")</button>
                    }
                    <button class="secondary" @onclick="Edit">✎ @S.T("ui.edit")</button>
                }
                <span class="speed">
                    @foreach (var sp in new[] { 1, 2, 4, 8 })
                    {
                        int speed = sp;
                        <button class="tiny @(speed == _speed ? "on" : "")" @onclick="() => _speed = speed">@(speed)×</button>
                    }
                </span>
            </div>

            @if (Shown is { } run)
            {
                <div class="timeline">
                    <input type="range" min="0" max="@(run.Frames.Count - 1)" value="@_frame" @oninput="Scrub" />
                    <span>@S.T("ui.tick", ("tick", Current?.Tick ?? 0))</span>
                </div>
                @if (AtEnd)
                {
                    <p class="ending @run.Ending.ToString().ToLowerInvariant()">@S.T($"ui.ending.{run.Ending}", ("got", run.Result), ("want", run.Case.Expected))</p>
                }
            }
        </section>

        <section class="brief order">
            <p class="order-head">@S.T("ui.order", ("n", _levelIndex + 1)) · @S.T("ui.order-from")</p>
            <h2>@S.T($"level.{Level.Key}.name") @if (Level.Bug) { <small class="tag">@S.T("ui.real-bug")</small> }</h2>
            <p>@S.T($"level.{Level.Key}.brief")</p>
            <table class="cases">
                <thead><tr><th>@S.T("ui.in")</th><th>@S.T("ui.want")</th><th></th></tr></thead>
                <tbody>
                    @for (int i = 0; i < Level.Cases.Count; i++)
                    {
                        int index = i;
                        var c = Level.Cases[i];
                        var result = _run?.Cases[i];
                        bool revealed = result is not null && _revealed.Contains(index);
                        bool fresh = revealed && index == _fresh;
                        <tr class="@(index == _case && _run is not null ? "current" : "") @(revealed ? (result!.Passed ? "pass" : "fail") : "") @(fresh ? "fresh" : "")"
                            @key="(index, fresh ? _freshSeq : 0)" @onclick="() => _run is not null ? ShowCase(index) : Task.CompletedTask">
                            <td>@c.Input</td>
                            <td>@c.Expected</td>
                            <td class="mark">
                                @if (revealed && result!.Passed)
                                {
                                    <span class="ok">✓
                                        @if (fresh)
                                        {
                                            @* Vuurwerk: twaalf vonken die uit het vinkje spatten *@
                                            <span class="burst" aria-hidden="true">
                                                @for (int s = 0; s < 12; s++)
                                                {
                                                    <i style="--a:@(s * 30)deg; --d:@(22 + (s % 3) * 8)px"></i>
                                                }
                                            </span>
                                        }
                                    </span>
                                }
                                else if (revealed)
                                {
                                    <span class="stamp">@S.T("ui.fail")</span> <span class="why">@Outcome(result!)</span>
                                }
                                else if (_run is not null)
                                {
                                    <span class="wait">…</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (AllRevealed && _run is { } done)
            {
                <div class="result @(done.Solved ? "won" : "lost")" @key="_freshSeq">
                    <h3>@S.T(done.Solved ? "ui.solved" : "ui.not-yet")</h3>
                    <p>@S.T("ui.score", ("machines", done.Machines), ("cycles", done.Cycles))</p>
                    @if (_best.TryGetValue(Level.Key, out var best))
                    {
                        <p class="best">@S.T("ui.best", ("machines", best.Machines), ("cycles", best.Cycles))</p>
                    }
                    @if (done.Solved && _levelIndex < LevelCatalog.All.Count - 1)
                    {
                        <button class="primary" @onclick="() => SelectLevel(_levelIndex + 1)">@S.T("ui.next") →</button>
                    }
                    @if (done.Solved && Level.Bug)
                    {
                        <div class="codex">
                            <h4>Codex · @S.T($"bug.{Level.Key}.title")</h4>
                            <p>@S.T($"bug.{Level.Key}.story")</p>
                        </div>
                    }
                </div>
            }
        </section>
    </main>
</div>

@code {
    private static readonly Dir[] Dirs = [Dir.Up, Dir.Right, Dir.Down, Dir.Left];

    private RenderFragment DirPicker(string label, Dir current, Func<Dir, Task> set) =>
        @<div class="row">
            <span>@label</span>
            <span class="dirs">
                @foreach (var d in Dirs)
                {
                    var dir = d;
                    <button class="tiny @(dir == current ? "on" : "")" @onclick="() => set(dir)">@Components.PieceText.Arrow(dir)</button>
                }
            </span>
        </div>;

    private RenderFragment ValuePicker(int current, Func<int, Task> set)
    {
        var choices = _selected is { } c && _board.TryGetValue(c, out var p) && OfferFor(p) is { } offer ? offer.Choices : [];
        if (choices.Count < 2) return @<span></span>;
        return @<label class="row">@S.T("ui.number")
            <select value="@current" @onchange="e => set(int.Parse((string)e.Value!))">
                @foreach (var v in choices)
                {
                    <option value="@v">@v</option>
                }
            </select>
        </label>;
    }

    /// <summary>Wat er misging, kort, voor de tabel: de verkeerde inhoud, of waarom de kist nooit aankwam.</summary>
    private string Outcome(CaseRun run) => run.Ending switch
    {
        Ending.Forever => S.T("ui.short.forever"),
        Ending.FellOff => S.T("ui.short.fell-off"),
        _ => run.Result.ToString(),
    };

    private static string CellClass(Piece? piece) => piece switch
    {
        null => "empty",
        Belt => "belt",
        Machine => "machine",
        Gate => "gate",
        Counter => "counter",
        Source => "source",
        Output => "output",
        _ => "",
    };

    private RenderFragment CellContent(Piece? piece, int? count) => piece switch
    {
        Belt b => @<span class="arrow">@Components.PieceText.Arrow(b.Out)</span>,
        Machine m => @<span class="stack"><b>@Components.PieceText.Op(m.Op)</b><small>@Components.PieceText.Arrow(m.Out)</small></span>,
        Gate g => @<span class="stack"><b>@Components.PieceText.Condition(g.When)</b><small>✓@Components.PieceText.Arrow(g.IfTrue) ✗@Components.PieceText.Arrow(g.IfFalse)</small></span>,
        Counter c => @<span class="stack"><b>@(count ?? 0)/@c.Times</b><small>↻@Components.PieceText.Arrow(c.Loop) ⇥@Components.PieceText.Arrow(c.Done)</small></span>,
        Source s => @<span class="stack"><b>@S.T("ui.in")</b><small>@Components.PieceText.Arrow(s.Out)</small></span>,
        Output => @<span class="stack"><b>@S.T("ui.out-cell")</b></span>,
        _ => @<span></span>,
    };
}
