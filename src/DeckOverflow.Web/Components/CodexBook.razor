@using DeckOverflow.Engine.Codex
@inject Strings S

@* De Codex is het boek: een tabblad per hoofdstuk van Zie Scherp Scherper, over alle spelvormen heen.
   Een open pagina is een stapeltje van vier bladen die je zelf omslaat: wat er gebeurde (met een
   mini-animatie van jouw moment), de naam, de code, het boek. Zolang je een pagina niet uitlas,
   zie je de randen van de volgende bladen en een ezelsoor; het tabblad krijgt een stip.
   Hoofdstukken die nog niet aan bod kwamen, zijn dichtgeniet: alleen een nummer. *@

<div class="modal" @onclick="OnClose">
    <div class="modal-body codex-book" @onclick:stopPropagation="true">
        <h2>@S.T("ui.codex")</h2>
        <p class="hint">@S.T("ui.codex.intro") · @S.T("ui.codex.count", ("open", OpenCount), ("total", OpenTotal))</p>

        <nav class="codex-tabs">
            @for (int chapter = FirstChapter; chapter <= LastChapter; chapter++)
            {
                int ch = chapter;
                if (IsOpen(ch))
                {
                    <button class="codex-tab @(ch == _chapter ? "current" : "")" @onclick="() => _chapter = ch">
                        @S.T("ui.codex.tab", ("chapter", ch))
                        @if (HasUnread(ch))
                        {
                            <span class="unread-dot" title="@S.T("ui.codex.unread")"></span>
                        }
                    </button>
                }
                else
                {
                    <span class="codex-tab stapled @(ch == Leak ? "leak" : "")" title="@S.T("ui.codex.stapled")">
                        @S.T("ui.codex.tab", ("chapter", ch))
                        @if (ch == Leak)
                        {
                            @* Eén hoekje steekt uit: een regel zoals in een handleiding, meer niet *@
                            <span class="corner">@S.T("ui.codex.leak")</span>
                        }
                    </span>
                }
            }
        </nav>

        <div class="codex-pages">
            @foreach (var entry in CodexCatalog.All.Where(e => e.Chapter == _chapter))
            {
                if (!Pages.TryGetValue(entry.Key, out var values))
                {
                    <div class="codex-page locked" title="@S.T("ui.codex.locked-hint")">
                        <strong>@S.T("ui.codex.locked")</strong>
                    </div>
                    continue;
                }

                int layer = Layer(entry.Key);
                @* Het aantal zichtbare randen eronder: zoveel bladen liggen er nog *@
                <div class="codex-page open sheets-@(4 - layer) @(entry.Key == _focus ? "focus" : "")">
                    @if (layer < 4)
                    {
                        <span class="dog-ear" title="@S.T("ui.codex.unread")"></span>
                    }
                    <h3>@(layer >= 2 ? S.T($"codex.{entry.Key}.name") : S.T("ui.codex.happened"))</h3>
                    <CodexReplay Key="@entry.Key" Values="values" />
                    <p>@S.T(new TextRef($"codex.{entry.Key}.happened", values))</p>

                    @if (layer >= 3)
                    {
                        <pre class="code">@S.T(new TextRef($"codex.{entry.Key}.code", values))</pre>
                    }
                    @if (layer >= 4)
                    {
                        <a class="read" href="@(BookUrl + entry.BookPage)" target="_blank" rel="noopener">@(entry.Chapter is { } chapter ? S.T("ui.codex.chapter", ("chapter", chapter)) : S.T("ui.codex.chapter-later")) ↗</a>
                    }

                    <div class="page-foot">
                        <span class="page-count">@S.T("ui.codex.page", ("layer", layer))</span>
                        @if (layer < 4)
                        {
                            string next = layer switch { 1 => "ui.codex.reveal-name", 2 => "ui.codex.reveal-code", _ => "ui.codex.reveal-read" };
                            <button class="read-on" @onclick="() => TurnAsync(entry.Key, layer + 1)">@S.T(next) →</button>
                        }
                    </div>
                </div>
            }
        </div>

        <button class="secondary" @onclick="OnClose">@S.T("ui.close")</button>
    </div>
</div>

@code {
    /// <summary>De online versie van Zie Scherp Scherper.</summary>
    private const string BookUrl = "https://timdams.github.io/ziescherpscherper/content/";

    /// <summary>Hoofdstuk 1 is de inleiding; het boek telt 18 hoofdstukken.</summary>
    private const int FirstChapter = 2;
    private const int LastChapter = 18;

    /// <summary>De hoofdstukken van de deckbuilder: die staan altijd open.</summary>
    private const int LastOpenChapter = 4;

    /// <summary>Het dichtgeniete tabblad waar een hoekje uitsteekt: beslissingen, de Controlekamer.</summary>
    private const int Leak = 5;

    /// <summary>Open pagina's, met de getallen van het moment waarop ze opengingen.</summary>
    [Parameter, EditorRequired] public IReadOnlyDictionary<string, IReadOnlyDictionary<string, string>> Pages { get; set; } = default!;

    /// <summary>Hoe ver elke pagina al gelezen is: 1 wat er gebeurde, 2 de naam, 3 de code, 4 het boek.</summary>
    [Parameter] public IReadOnlyDictionary<string, int> Read { get; set; } = new Dictionary<string, int>();

    /// <summary>Een blad omgeslagen: de shell onthoudt het.</summary>
    [Parameter] public EventCallback<(string Key, int Layer)> OnRead { get; set; }

    /// <summary>Een pagina om meteen te tonen, bv. de nieuwe na een gevecht.</summary>
    [Parameter] public string? Focus { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    private string? _focus;
    private int _chapter = FirstChapter;

    private int Layer(string key) => Math.Clamp(Read.GetValueOrDefault(key, 1), 1, 4);

    private Task TurnAsync(string key, int layer) => OnRead.InvokeAsync((key, layer));

    /// <summary>Een tabblad is open voor de hoofdstukken van de deckbuilder, of zodra er een pagina in openging.</summary>
    private bool IsOpen(int chapter) =>
        chapter <= LastOpenChapter || CodexCatalog.All.Any(e => e.Chapter == chapter && Pages.ContainsKey(e.Key));

    private bool HasUnread(int chapter) =>
        CodexCatalog.All.Any(e => e.Chapter == chapter && Pages.ContainsKey(e.Key) && Layer(e.Key) < 4);

    private IEnumerable<CodexEntry> OpenEntries => CodexCatalog.All.Where(e => e.Chapter is { } c && IsOpen(c));

    /// <summary>De teller telt alleen open tabbladen: "3 van 11", nooit "3 van 87".</summary>
    private int OpenTotal => OpenEntries.Count();
    private int OpenCount => OpenEntries.Count(e => Pages.ContainsKey(e.Key));

    protected override void OnParametersSet()
    {
        if (Focus == _focus) return;
        _focus = Focus;
        if (Focus is not null && CodexCatalog.All.FirstOrDefault(e => e.Key == Focus)?.Chapter is { } chapter) _chapter = chapter;
    }
}
