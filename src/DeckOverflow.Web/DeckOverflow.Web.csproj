<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <RootNamespace>DeckOverflow.Web</RootNamespace>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- Kleinere download: geen cultuurdata nodig voor de spike -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeckOverflow.Core\DeckOverflow.Core.csproj" />
    <ProjectReference Include="..\DeckOverflow.CardHall\DeckOverflow.CardHall.csproj" />
    <ProjectReference Include="..\DeckOverflow.ControlRoom\DeckOverflow.ControlRoom.csproj" />
    <ProjectReference Include="..\DeckOverflow.ConveyorBelt\DeckOverflow.ConveyorBelt.csproj" />
    <!-- Events en snapshots gaan via reflectie naar JSON: niets uit de motor wegtrimmen -->
    <TrimmerRootAssembly Include="DeckOverflow.Core" />
    <TrimmerRootAssembly Include="DeckOverflow.CardHall" />
  </ItemGroup>

</Project>
