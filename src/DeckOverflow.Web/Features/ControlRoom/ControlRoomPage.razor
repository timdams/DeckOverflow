@page "/control-room"
@using DeckOverflow.ControlRoom.Gambits
@using DeckOverflow.ControlRoom.Levels

@* De Controlekamer (H5): je stelt de regels van een automaat op en kijkt hoe hij vecht. Een echte controlekamer, zoals
   de beeldtaal vraagt (docs/wereld/beeldtaal.md): links jouw schakelkast met de gereedschapsbak en het luik onder de
   motorkap, in het midden de testcel met de ponsband, rechts de verzegelde kast van de vijand. *@

<div class="room control-room">
    @if (!S.Loaded)
    {
        <div class="overlay"><h1>Deck Overflow</h1><p>...</p></div>
    }
    else if (!Unlocked)
    {
        <div class="overlay">
            <h1>@S.T("ui.world.control-room.name")</h1>
            <p>@LockedText</p>
            <button @onclick="ToFloorPlan">@S.T("ui.world.back")</button>
        </div>
    }
    else
    {
        <header class="room-head">
            <button class="options-button" title="@S.T("ui.options")" aria-label="@S.T("ui.options")" @onclick="OpenOptionsAsync">☰</button>
            <span class="step-badge" aria-hidden="true">@Departments.Get(Departments.ControlRoom).Step</span>
            <div class="room-title">
                <h1 class="heavy">@S.T("ui.world.control-room.name")</h1>
                <small>@S.T("room.ui.fight-of", ("n", _levelIndex + 1), ("total", LevelCatalog.All.Count)) · @S.T($"room.enemy.{Level.Key}")</small>
            </div>
            <nav class="steps">
                @for (int i = 0; i < LevelCatalog.All.Count; i++)
                {
                    int index = i;
                    var l = LevelCatalog.All[i];
                    bool open = LevelOpen(index);
                    <button class="step @(index == _levelIndex ? "current" : "") @(Record(l.Key).Beaten ? "beaten" : "") @(l.Bug ? "bug" : "")"
                            disabled="@(!open || _playing)" @onclick="() => SelectLevelAsync(index)"
                            title="@(open ? S.T($"room.enemy.{l.Key}") : S.T("ui.world.locked"))">
                        <span class="circle">@(index + 1)</span>
                        <span class="label">@(open ? S.T($"room.enemy.{l.Key}") : "?")</span>
                    </button>
                }
            </nav>
            <span class="head-tools">
                <button class="title-button" @onclick="() => OpenCodex(null)">@S.T("ui.codex") · @_progress.Codex.Count</button>
                <button class="title-button" @onclick="() => _showXRegister = true">@S.T("ui.xregister") · @_progress.XPanels.Count</button>
            </span>
        </header>

        <main class="room-floor">
            <section class="board mine">
                <div class="cabinet">
                    <div class="cabinet-head">
                        <h2 class="stencil">@S.T("room.ui.cabinet")</h2>
                        <small>@S.T("room.ui.slots", ("used", _drafts.Count), ("max", Level.Slots))</small>
                    </div>
                    <p class="hint">↓ @S.T("room.ui.top-first")</p>
                    <RuleBoard Rules="_drafts" Editable="Editing" Level="Level" Slots="Level.Slots"
                               Checks="Level.Checks" Moves="Level.Moves" Joins="Level.Joins" AllowNot="Level.AllowNot"
                               Checked="Shown?.PlayerChecked" Fired="Shown?.PlayerFired" Finished="AtEnd"
                               FlashIndex="FlashOf(Side.Player)" OnChanged="BoardChangedAsync" />
                </div>

                @* Het luik onder de motorkap: dicht een gearceerd luik, open je bord als C#, met de regel die nu vuurt *@
                <div class="hatch @(_showCode ? "open" : "")">
                    <button class="hatch-lid" aria-expanded="@(_showCode ? "true" : "false")" @onclick="() => _showCode = !_showCode">
                        <span class="stencil">@S.T("room.ui.code")</span>
                        <small>@S.T(_showCode ? "room.ui.hatch-close" : "room.ui.hatch-open")</small>
                    </button>
                    @if (_showCode)
                    {
                        <pre class="code">@foreach (var line in RuleText.CSharpLines(S, _drafts.Select(d => d.ToRule()).ToList()))
                        {<span class="line @(line.Rule >= 0 && line.Rule == FlashOf(Side.Player) ? "now" : "")">@line.Text</span>}</pre>
                    }
                </div>
            </section>

            <section class="arena">
                @* De testcel: het duel door een raam met een dikke lijst en een bordje *@
                <div class="test-cell">
                    <span class="cell-sign stencil">
                        @S.T("room.ui.test-cell", ("n", _levelIndex + 1))@if (Shown is { Turn: > 0 } now)
                        {
                            <text> · @S.T("room.ui.turn-short", ("turn", now.Turn))</text>
                        }
                    </span>
                    <div class="stage-box" @ref="_host"></div>
                </div>

                <div class="controls">
                    @* De ene grote knop: starten, pauzeren of verder, zoals op een machine *@
                    @if (Editing)
                    {
                        <button class="big-round" disabled="@(_drafts.Count == 0)" title="@S.T("room.ui.run")" aria-label="@S.T("room.ui.run")" @onclick="RunAsync"><MachineIcon Kind="play" /></button>
                        <span class="big-label heavy">@S.T("room.ui.run")</span>
                    }
                    else if (_playing)
                    {
                        <button class="big-round paper" title="@S.T("room.ui.pause")" aria-label="@S.T("room.ui.pause")" @onclick="Stop"><MachineIcon Kind="pause" /></button>
                        <span class="big-label heavy">@S.T("room.ui.running")</span>
                    }
                    else if (!AtEnd)
                    {
                        <button class="big-round" title="@S.T("room.ui.resume")" aria-label="@S.T("room.ui.resume")" @onclick="ResumeAsync"><MachineIcon Kind="play" /></button>
                        <button @onclick="StepAsync">⏭ @S.T("room.ui.step")</button>
                    }
                    else
                    {
                        <button class="big-round paper" title="@S.T("room.ui.replay")" aria-label="@S.T("room.ui.replay")" @onclick="RunAsync">↻</button>
                        <span class="big-label heavy">@S.T("room.ui.over")</span>
                    }
                    @if (!Editing && !AtEnd)
                    {
                        @* Aan het einde staat deze knop in de uitslag *@
                        <button class="secondary" @onclick="EditAsync">✎ @S.T("room.ui.edit")</button>
                    }
                    <span class="counters">
                        <span class="score"><span class="stencil">@S.T("room.ui.hist-turns")</span><Digits Value="@(Shown is { } s ? s.Turn.ToString() : "–")" Min="2" Class="@(Shown is null ? "dim" : "")" /></span>
                        <span class="score"><span class="stencil">@S.T("room.ui.hist-rules")</span><Digits Value="@_drafts.Count.ToString()" /></span>
                    </span>
                    <span class="speed">
                        @foreach (var sp in new[] { 1, 2, 4 })
                        {
                            int speed = sp;
                            <button class="tiny @(speed == _speed ? "on" : "")" @onclick="() => SetSpeedAsync(speed)">@(speed)×</button>
                        }
                    </span>
                </div>

                @if (_recording is not null)
                {
                    @* De ponsband: per beurt een gaatje voor jou en een voor de vijand, met de regel die vuurde.
                       Het duel ligt vast, dus een klik op een gaatje springt naar die zet, ook terug *@
                    <div class="punch-tape" role="group" aria-label="@S.T("room.ui.timeline")">
                        <div class="tape-head">
                            <span class="stencil">@S.T("room.ui.tape")</span>
                            <small>@S.T("room.ui.tape-hint")</small>
                        </div>
                        <div class="tape-strip" @ref="_tapeStrip">
                            <div class="tape-rows" aria-hidden="true"><span>@S.T("room.ui.tape-you")</span><span>@S.T("room.ui.tape-them")</span></div>
                            <button class="tape-start @(_frame < 0 ? "now" : "")" title="@S.T("room.ui.tape-start")" aria-label="@S.T("room.ui.tape-start")" @onclick="() => JumpAsync(-1)">⏮</button>
                            @foreach (var column in Tape())
                            {
                                <div class="tape-col">
                                    @Hole(column.Turn, column.Player)
                                    @Hole(column.Turn, column.Enemy)
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (_recording is { } done && AtEnd)
                {
                    <div class="result @done.Outcome.ToString().ToLowerInvariant()">
                        @switch (done.Outcome)
                        {
                            case Outcome.PlayerWon:
                                <span class="rubber-stamp slam big">@S.T("room.ui.won")</span>
                                <p>@S.T("room.ui.won-detail", ("turns", done.Turns), ("rules", done.Rules.Count), ("hp", done.Frames[^1].Snapshot.Player.Hp))</p>
                                break;
                            case Outcome.EnemyWon:
                                <h3 class="heavy">@S.T("room.ui.lost")</h3>
                                <p>@LostDetail(done.Frames[^1].Snapshot.Enemy)</p>
                                break;
                            default:
                                <h3 class="heavy">@S.T("room.ui.shift-over")</h3>
                                <p>@S.T("room.ui.shift-over-detail", ("turns", done.Turns))</p>
                                break;
                        }

                        @if (done.Score is { } score && _histograms.TryGetValue(Level.Key, out var histogram))
                        {
                            @* Zoals Opus Magnum: waar staat jouw bord tussen alle borden die winnen? *@
                            <div class="histograms">
                                @Bars(S.T("room.ui.hist-turns"), histogram.Turns, score.Turns, Record(Level.Key).BestTurns)
                                @Bars(S.T("room.ui.hist-rules"), histogram.Rules, score.Rules, Record(Level.Key).BestRules)
                            </div>
                            <p class="hint">@S.T("room.ui.hist-hint", ("total", histogram.Total), ("max", Histogram.MaxRules))</p>
                        }

                        <div class="actions">
                            <button class="secondary" @onclick="EditAsync">✎ @S.T("room.ui.edit")</button>
                            @if (done.Won && _levelIndex < LevelCatalog.All.Count - 1)
                            {
                                <button class="primary" @onclick="NextLevelAsync">@S.T("room.ui.next") →</button>
                            }
                            else if (done.Won)
                            {
                                <button class="primary" @onclick="ToFloorPlan">@S.T("ui.world.back")</button>
                            }
                        </div>

                        @if (done.Won && Level.Bug)
                        {
                            <div class="codex-bug">
                                <span class="codex-label">@S.T("codex.title")</span>
                                <strong>@S.T($"bug.{Level.Key}.title")</strong>
                                <p>@S.T($"bug.{Level.Key}.story")</p>
                            </div>
                        }

                        <FeedbackHeart @key="Level.Key" Department="control-room" Subject="@($"level:{Level.Key}")"
                                       Question="@TextRef.Of("room.ui.feedback", ("name", S.T($"room.enemy.{Level.Key}")))" />
                    </div>
                }

                <ol class="log">
                    @foreach (var line in Log())
                    {
                        <li class="@line.Kind">@line.Text</li>
                    }
                </ol>
            </section>

            <section class="board theirs">
                @* De kast van de vijand: dezelfde platen en lampen, verzegeld. Lezen mag *@
                <div class="cabinet sealed">
                    <div class="cabinet-head">
                        <h2 class="stencil">@S.T("room.ui.enemy-cabinet", ("name", S.T($"room.enemy.{Level.Key}")))</h2>
                        @if (Level.Bug)
                        {
                            <span class="bug-tag">@S.T("room.ui.real-bug")</span>
                        }
                    </div>
                    <p class="hint">@S.T("room.ui.sealed")</p>
                    <RuleBoard Rules="_enemyDrafts" Checked="Shown?.EnemyChecked" Fired="Shown?.EnemyFired" Finished="AtEnd"
                               FlashIndex="FlashOf(Side.Enemy)" />
                    <p class="flavor">@S.T($"room.flavor.{Level.Key}")</p>
                    <span class="seal" aria-hidden="true">@S.T("room.ui.seal")</span>
                </div>
                @if (Level.Bug)
                {
                    @* Het dossier van een echte bug: welke, wie en wanneer. Het verhaal zelf komt pas na de overwinning *@
                    <div class="dossier">
                        <div class="dossier-head"><span class="stencil">@S.T("room.ui.dossier")</span><span class="bug-tag">@S.T("room.ui.real-bug")</span></div>
                        <strong class="dossier-title">@S.T($"bug.{Level.Key}.title")</strong>
                        <p class="dossier-hint">@S.T("room.ui.dossier-hint")</p>
                    </div>
                }
                @if (_showCode)
                {
                    <pre class="code">@foreach (var line in RuleText.CSharpLines(S, Level.EnemyRules))
                    {<span class="line @(line.Rule >= 0 && line.Rule == FlashOf(Side.Enemy) ? "now" : "")">@line.Text</span>}</pre>
                }
            </section>
        </main>

        <LanguageToggle Class="corner" />
    }

    @if (_showOptions)
    {
        <div class="modal" @onclick="() => _showOptions = false">
            <div class="modal-body story-card options" @onclick:stopPropagation="true">
                <h2>@S.T("ui.options.title")</h2>
                <div class="choices column">
                    <button @onclick="ToFloorPlan">@S.T("ui.world.back")</button>
                    <button @onclick="ToggleSoundAsync">@S.T(_soundOn ? "ui.options.sound-on" : "ui.options.sound-off")</button>
                </div>
                <LanguageToggle />
                <button class="play-big" @onclick="() => _showOptions = false">@S.T("room.ui.back-to-room")</button>
            </div>
        </div>
    }
    @if (_showCodex)
    {
        <CodexBook Pages="_progress.Codex" Read="_progress.CodexRead" OnRead="TurnCodexPageAsync" Focus="_codexFocus" OnClose="() => _showCodex = false" />
    }
    @if (_showXRegister)
    {
        <XRegisterBook Earned="_progress.XPanels" OnClose="() => _showXRegister = false" />
    }

    <div class="xpanel-popups">
        @foreach (var popup in _popups)
        {
            <button class="xpanel-popup" @key="popup.Id" @onclick="() => { _popups.Remove(popup); _showXRegister = true; }">
                <span class="badge">✗</span>
                <span class="words">
                    <span class="label">@S.T("ui.xregister.earned")</span>
                    <strong>@S.T($"xpanel.{popup.Key}.name")</strong>
                    <small>@S.T($"xpanel.{popup.Key}.text")</small>
                </span>
            </button>
        }
    </div>
    <div class="toasts">
        @foreach (var toast in _toasts)
        {
            <div class="toast" @key="toast.Id">@toast.Text</div>
        }
    </div>
    <div class="rotate-hint">
        <span class="rotate-phone" aria-hidden="true"></span>
        <p>@(S.Loaded ? S.T("ui.rotate") : "")</p>
    </div>
</div>

@code {
    /// <summary>
    /// Een gaatje in de ponsband: het nummer van de regel die vuurde, of een streepje als er niets klopte. Wat al
    /// gespeeld is, is geponst; de zet in beeld heeft een oranje ring.
    /// </summary>
    private RenderFragment Hole(int turn, Punch? punch)
    {
        if (punch is not { } p) return @<span class="hole blank"></span>;
        // Wat nog moet komen, verklapt de band niet: een leeg gaatje, alleen om erheen te springen
        bool punched = p.Frame <= _frame;
        string label = !punched ? S.T("room.ui.tape-ahead", ("turn", turn))
            : p.Rule is int rule ? S.T("room.ui.tape-punch", ("turn", turn), ("rule", rule + 1))
            : S.T("room.ui.tape-none", ("turn", turn));
        string mark = !punched ? "" : p.Rule is int r ? (r + 1).ToString() : "–";
        return @<button class="hole @(punched ? "punched" : "") @(p.Frame == _frame ? "now" : "")"
                        title="@label" aria-label="@label" @onclick="() => JumpAsync(p.Frame)">@mark</button>;
    }

    /// <summary>Een histogram als staafjes, met jouw bord in inkt en je beste ooit omkaderd.</summary>
    private RenderFragment Bars(string title, IReadOnlyDictionary<int, int> bars, int yours, int? best) =>
        @<div class="histogram">
            <span class="hist-title">@title</span>
            <div class="hist-bars">
                @foreach (var key in bars.Keys.Append(yours).Distinct().Order())
                {
                    <span class="bar @(key == yours ? "yours" : "") @(key == best ? "best" : "")" title="@key: @bars.GetValueOrDefault(key)">
                        <span class="fill" style="height:@(Math.Max(4, BarHeight(bars, key)).ToString(System.Globalization.CultureInfo.InvariantCulture))%"></span>
                        <span class="key">@key</span>
                    </span>
                }
            </div>
        </div>;
}
